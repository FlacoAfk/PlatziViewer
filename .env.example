# Copia este archivo a .env (solo uso local) y ajusta según tu entorno

# Puerto del servidor
PORT=8080
# Host de bind (0.0.0.0 para Docker/red local)
HOST=127.0.0.1
# Host mostrado en logs
PUBLIC_HOST=127.0.0.1

# Ruta raíz del proyecto (opcional)
# PLATZI_VIEWER_PATH=H:\\Mi unidad\\platzi-viewer

# Ruta al JSON de cuenta de servicio de Google (recomendado fuera del repo)
# GOOGLE_SERVICE_ACCOUNT_FILE=H:\\secure\\service_account.json
# Alternativa: credencial completa en una sola variable JSON
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Tamaño máximo permitido para progress.json (bytes)
MAX_PROGRESS_BYTES=2097152
